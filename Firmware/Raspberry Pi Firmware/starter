#!/usr/bin/env bash
set -euo pipefail

PORT="/dev/ttyS0"
BAUD="115200"
RUNTEST="./runtest"
DRAIN_SECS="0.3"

# Configure serial
stty -F "$PORT" "$BAUD" cs8 -cstopb -parenb -ixon -ixoff -crtscts raw -echo

timeout "$DRAIN_SECS" cat "$PORT" >/dev/null 2>&1 || true

echo "Listening on $PORT @ $BAUD ..."
echo "Tip: if you see JSON but no trigger, look at the [ESC] line for hidden chars."

while IFS= read -r raw; do
  # Show what we got
  printf '[RAW] %s\n' "$raw"
  printf '[ESC] %q\n' "$raw"

  # Clean common serial garbage: remove CR and NUL bytes
  clean="$(printf '%s' "$raw" | tr -d '\r\000')"

  # Optionally, if your sender sometimes prefixes text, uncomment to extract {...} substring:
  # clean="$(grep -o '{.*}' <<<"$clean" || true)"

  printf '[CLN] %s\n' "$clean"

  # Validate JSON + required fields
  if jq -e '.Startup? and (.Startup.Frequency? != null) and (.Startup.Load? != null)' \
      >/dev/null 2>&1 <<<"$clean"
  then
    freq="$(jq -r '.Startup.Frequency' <<<"$clean")"
    load="$(jq -r '.Startup.Load'      <<<"$clean")"

    printf '[OK ] Parsed -> Frequency=%s Load=%s\n' "$freq" "$load"
    printf '[RUN] sudo -n %s %s %s\n' "$RUNTEST" "$freq" "$load"

    # Use -n so it fails fast if sudo needs a password (instead of silently "hanging")
    if ! sudo -n "$RUNTEST" "$freq" "$load"; then
      echo '[ERR] sudo failed (likely needs a password). Fix by enabling passwordless sudo for runtest, or run script with sudo.' >&2
    fi
  else
    echo "[NO ] jq didn't match Startup/Frequency/Load"
  fi

done < "$PORT"





